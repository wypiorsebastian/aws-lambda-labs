*.zip

# ─────────────────────────────────────────────
# Terraform / IaC
# ─────────────────────────────────────────────

# Local .terraform directories (init artifacts)
**/.terraform/
**/.terraform.lock.hcl

# Terraform state — NIE commituj stanu do repo
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Plany Terraform
*.tfplan

# Zmienne z sekretami (credentials, keys)
*.tfvars
!*.tfvars.example

# Override files (lokalny development)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

